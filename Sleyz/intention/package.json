{
  "name": "converza",
  "version": "1.0.0",
  "description": "Autonomous lead qualifier — first-responder microservice for brand DMs",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs"
  },
  "keywords": [
    "lead-qualification",
    "llm",
    "structured-outputs",
    "dm"
