SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
BACKEND_API_KEY=generate_a_real_random_value_here
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

HUAWEI_MAAS_API_KEY=your_huawei_maas_key_here
# Use the exact OpenAI-compatible URL from your MaaS deployment.
HUAWEI_MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/v2
HUAWEI_MAAS_MODEL=deepseek-v4.1-flash
# Separate from the web proxy key. Only trusted publishers receive this value.
PUBLISHER_API_KEY=generate_a_separate_random_value_here
LLM_SERVICE_API_KEY=generate_a_different_inference_service_value_here

MONEYPRINTERTURBO_BASE_URL=http://127.0.0.1:8080
MONEYPRINTERTURBO_PUBLIC_BASE_URL=http://127.0.0.1:8080
# Same private worker credential in core and the approved-only renderer.
MPT_API_KEY=replace_with_a_private_worker_credential
PEXELS_API_KEY=your_pexels_key_here

# VEA deterministic production. Enable only after migration 009, catalog and models are provisioned.
VEA_PRESETS_ENABLED=0
VEA_ENABLED=0
VEA_ASSET_ROOT=/MoneyPrinterTurbo/brand-assets
VEA_ASSET_HOST_PATH=./brand-assets
VEA_MODEL_HOST_PATH=./vea-models
ELEVENLABS_API_KEY=
VEA_ELEVENLABS_VOICES={"en":"your_voice_id","ru":"your_voice_id","uz":"your_voice_id"}
# Use installed, language-matching ONNX voices; leave unsupported languages absent.
VEA_PIPER_VOICES={}
VEA_WHISPER_MODEL=/MoneyPrinterTurbo/models/whisper-small
VEA_WHISPER_DEVICE=cpu
VEA_WHISPER_COMPUTE_TYPE=int8

# OpenClaw Engine
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_BEARER_TOKEN=your_openclaw_bearer_token_here

# SLEYZ ingress and worker (all values server-side).
SALES_BOT_TOKEN=your_telegram_sales_bot_token
SALES_WEBHOOK_SECRET=generate_a_random_webhook_secret
MANAGER_BOT_TOKEN=your_telegram_manager_bot_token
INSTAGRAM_APP_SECRET=your_meta_app_secret
INSTAGRAM_VERIFY_TOKEN=generate_a_random_instagram_verification_token
INSTAGRAM_CONNECTIONS={}
# Example shape: {"123456789":{"org_id":"workspace UUID","access_token":"server-only token"}}
INSTAGRAM_GRAPH_VERSION=v26.0
