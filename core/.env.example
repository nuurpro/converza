SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
BACKEND_API_KEY=generate_a_real_random_value_here
DEFAULT_ORG_ID=00000000-0000-0000-0000-000000000001

HUAWEI_MAAS_API_KEY=your_huawei_maas_key_here
# Use the exact OpenAI-compatible URL from your MaaS deployment.
HUAWEI_MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/v2
HUAWEI_MAAS_MODEL=your_deepseek_deployment_model
# Separate from the web proxy key. Only trusted publishers receive this value.
PUBLISHER_API_KEY=generate_a_separate_random_value_here
LLM_SERVICE_API_KEY=generate_a_different_inference_service_value_here

MONEYPRINTERTURBO_BASE_URL=http://127.0.0.1:8080

# OpenClaw Engine
OPENCLAW_URL=http://127.0.0.1:18789
OPENCLAW_BEARER_TOKEN=your_openclaw_bearer_token_here
